<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Data_nine">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/imageView48"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="-4dp"
                app:srcCompat="@drawable/zelig002" />

            <TextView
                android:id="@+id/textView25"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fez"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView26"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fez is a historical city located in northern Morocco, known for its ancient medina, vibrant culture, and stunning architecture."
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView27"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="It is one of the most popular tourist destinations in Morocco, offering visitors a glimpse into the country's rich history and cultural heritage."
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/imageView49"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/fez7" />

            <Button
                android:id="@+id/btn9.1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="the Medina of Fez" />

            <ImageView
                android:id="@+id/imageView50"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/fez8" />

            <Button
                android:id="@+id/btn9.2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="Al-Qarawiyyin Mosque and University" />

            <ImageView
                android:id="@+id/imageView51"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/fez9" />

            <Button
                android:id="@+id/btn9.3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="food" />

            <ImageView
                android:id="@+id/imageView52"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/fez10" />

            <Button
                android:id="@+id/btn9.4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="traditional art" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>