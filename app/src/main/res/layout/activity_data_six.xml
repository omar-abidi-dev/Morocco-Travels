<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Data_six">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/imageView35"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="-4dp"
                app:srcCompat="@drawable/zelig002" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="agadir"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agadir is a coastal city located in southwestern Morocco, known for its stunning beaches, vibrant culture, and year-round sunshine."
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView18"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="It is one of the most popular tourist destinations in Morocco, offering a range of activities and attractions for visitors of all ages."
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/imageView37"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/agadir7" />

            <Button
                android:id="@+id/btn6.1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="kasbah" />

            <ImageView
                android:id="@+id/imageView38"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/agadir1" />

            <Button
                android:id="@+id/btn6.2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="beach" />

            <ImageView
                android:id="@+id/imageView39"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/agadir10" />

            <Button
                android:id="@+id/btn6.3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:onClick="guide"
                android:text="activities" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>