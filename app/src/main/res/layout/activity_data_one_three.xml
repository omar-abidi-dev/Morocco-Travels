<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Data_one_three">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/imageView126"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="-4dp"
                app:srcCompat="@drawable/zelig002" />

            <TextView
                android:id="@+id/textView124"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="food"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView131"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/kechfood8" />

            <TextView
                android:id="@+id/textView125"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tagine: This is a traditional Moroccan dish, consisting of meat or vegetables slow-cooked in a clay pot with aromatic spices and herbs. The tagine is served with bread and can be found in many restaurants and cafes in Marrakech."
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/imageView128"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/kechfood1" />

            <TextView
                android:id="@+id/textView126"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Couscous: Another traditional Moroccan dish, couscous consists of steamed semolina grains served with vegetables and meat. It is a staple dish in Moroccan cuisine and can be found in many restaurants and cafes in Marrakech."
                android:textAlignment="center" />

            <ImageView
                android:id="@+id/imageView129"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:srcCompat="@drawable/kechfood" />

            <TextView
                android:id="@+id/textView127"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pastilla: This is a savory pastry made with layers of thin pastry filled with a mixture of chicken or pigeon meat, almonds, and spices. It is often served as a starter or appetizer in Moroccan cuisine."
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView128"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Harira: This is a traditional Moroccan soup made with tomatoes, lentils, chickpeas, and spices. It is often served during Ramadan as a starter dish."
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView129"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Moroccan mint tea: This is a popular drink in Morocco, served with sugar and fresh mint leaves. It is often served as a welcome drink in restaurants and cafes."
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView130"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Street food: Marrakech has a vibrant street food scene, with many vendors selling traditional Moroccan dishes such as grilled meat skewers, fried fish, and snails cooked in a spicy broth.  Bissara: This is a traditional Moroccan soup made with fava beans, olive oil, and spices. It is often served as a breakfast dish in Marrakech."
                android:textAlignment="center" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>